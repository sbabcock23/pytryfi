    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2",
    "sequelize-typescript": "^2.1.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0"
